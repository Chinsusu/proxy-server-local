[Unit]
Description=PGW API control plane
After=network-online.target nftables.service systemd-sysctl.service
Wants=network-online.target
Requires=nftables.service systemd-sysctl.service

[Service]
User=pgw-api
Group=pgw-control
EnvironmentFile=/etc/pgw/pgw.env
Environment=PGW_API_ADDR=127.0.0.1:8080
Environment=PGW_AGENT_SOCKET=/run/pgw/control/api-agent.sock
Environment=PGW_DATABASE_PATH=/var/lib/pgw/pgw.db
# systemd 249 does not expand the newer %d credential-directory specifier.
# This non-template unit has a stable credential directory path.
Environment=PGW_SECRETS_KEY_PATH=/run/credentials/pgw-api.service/secrets_key
LoadCredential=jwt_secret:/etc/pgw/jwt_secret
LoadCredential=admin_pass_hash:/etc/pgw/admin_pass_hash
LoadCredential=secrets_key:/etc/pgw/secrets.key
LoadCredential=agent_service_token:/etc/pgw/agent.token
LoadCredential=ui_proxy_token:/etc/pgw/credentials-current/ui_proxy_token
ExecStart=/usr/local/bin/pgw-api
Restart=on-failure
RestartSec=2s
UMask=0027
RuntimeDirectory=pgw/control
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=pgw
StateDirectoryMode=0750
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/pgw /run/pgw/control
ReadOnlyPaths=/var/lib/pgw/rules
LimitNOFILE=65536
MemoryMax=512M
TasksMax=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
