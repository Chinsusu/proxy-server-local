[Unit]
Description=PGW management UI
After=network-online.target pgw-api.service
Wants=network-online.target
Requires=pgw-api.service

[Service]
User=pgw-ui
Group=pgw-ui
EnvironmentFile=/etc/pgw/pgw.env
# Keep Ubuntu 22.04/systemd 249 compatibility without exposing secret bytes.
Environment=PGW_UI_TLS_CERT_FILE=/run/credentials/pgw-ui.service/ui_tls_cert
Environment=PGW_UI_TLS_KEY_FILE=/run/credentials/pgw-ui.service/ui_tls_key
Environment=PGW_UI_WEB_DIR=/usr/local/share/pgw/web
LoadCredential=ui_tls_cert:/etc/pgw/credentials-current/ui.crt
LoadCredential=ui_tls_key:/etc/pgw/credentials-current/ui.key
LoadCredential=ui_proxy_token:/etc/pgw/credentials-current/ui_proxy_token
ExecStartPre=/usr/local/sbin/pgw-verify-ui-bind
ExecStart=/usr/local/bin/pgw-ui
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadOnlyPaths=/usr/local/share/pgw/web
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# AF_NETLINK: the pgw-verify-ui-bind ExecStartPre enumerates the LAN
# interface's addresses with ip(8), which requires a netlink socket; without
# it the sandboxed pre-check fails closed and the unit can never start.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitNOFILE=16384
MemoryMax=128M
TasksMax=1024
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
