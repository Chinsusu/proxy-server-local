{
  "schema": "pgw-external-attestor-handoff-v6",
  "status": "BLOCKED_UNPROVISIONED",
  "production_promotion_available": false,
  "candidate": {
    "repository": "Chinsusu/proxy-server-local",
    "workflow": ".github/workflows/ci.yml",
    "artifact_name_pattern": "pgw-candidate-diagnostic-<40-lowercase-source-sha>",
    "closed_subject": "pgw-release-candidate.tar",
    "authority": "none"
  },
  "required_external_orchestrator": {
    "repository": "Chinsusu/trusted-release-attestor",
    "repository_must_differ_from_candidate_repository": true,
    "evidence_repository_must_differ_from_candidate_and_attestor": true,
    "workflow": ".github/workflows/attest-release.yml",
    "required_signer_certificate_trigger": "workflow_dispatch",
    "required_candidate_event": "push",
    "workflow_pinned_outside_candidate_sha": true,
    "download_candidate_as_data_only": true,
    "checkout_candidate_repository": false,
    "execute_candidate_files": false,
    "bootstrap_asset_credential": "ephemeral-github-token-contents-read",
    "offline_bundle_artifact_required": true,
    "permissions": {
      "contents": "read",
      "id-token": "write",
      "attestations": "write"
    },
    "required_predicate_type": "https://github.com/Chinsusu/proxy-server-local/attestations/external-release/v1",
    "required_predicate_schema": "pgw-external-release-attestation-predicate-v2",
    "required_evidence_pins": [
      "producer_repository",
      "producer_workflow",
      "producer_ref",
      "producer_sha",
      "run_attempt",
      "public_key_spki_sha256"
    ],
    "required_candidate_bindings": [
      "repository",
      "workflow",
      "ref",
      "sha",
      "event",
      "closed_subject_sha256",
      "full_system_evidence_index_sha256",
      "full_system_raw_payload_sha256",
      "full_system_signature_verified",
      "transaction_model_full_system"
    ]
  },
  "required_deploy_policy": {
    "path": "/opt/pgw-release-trust/external-attestor.policy",
    "owner": "root:root",
    "mode": "0444",
    "format": "pgw-external-attestor-policy-v2",
    "must_pin": [
      "verifier_digest",
      "candidate_repository",
      "candidate_workflow",
      "signer_repository",
      "signer_workflow",
      "signer_ref",
      "signer_digest",
      "certificate_identity",
      "certificate_issuer",
      "predicate_type",
      "deny_self_hosted",
      "evidence_repository",
      "evidence_workflow",
      "evidence_ref",
      "evidence_sha",
      "evidence_run_attempt",
      "evidence_public_key_spki_sha256",
      "verifier_name",
      "verifier_version",
      "verifier_commit",
      "verifier_source_digest",
      "trusted_gh_sha256",
      "trusted_root_sha256"
    ]
  },
  "required_promoter": {
    "path": "/opt/pgw-release-trust/bin/attestor",
    "owner": "root:root",
    "mode": "0555",
    "digest_source": "external-attestor.policy:verifier_digest",
    "installed_outside_candidate_repository": true,
    "promotion_reachable_only_via_native_entrypoint": true,
    "input_modes": ["0400", "0440", "0444"]
  },
  "required_offline_sigstore": {
    "bundle_source": "actions/attest:bundle-path",
    "bundle_action": "actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6",
    "online_attestation_lookup": false,
    "trusted_root_path": "/opt/pgw-release-trust/sigstore-trusted-root.json",
    "trusted_root_owner": "root:root",
    "trusted_root_mode": "0444",
    "trusted_root_digest_source": "external-attestor.policy:trusted_root_sha256",
    "gh_path": "/opt/pgw-release-trust/bin/gh",
    "gh_owner": "root:root",
    "gh_mode": "0555",
    "gh_digest_source": "external-attestor.policy:trusted_gh_sha256",
    "required_flags": ["--bundle", "--custom-trusted-root", "--no-public-good"]
  },
  "promotion_transaction": {
    "release_root": "/var/lib/pgw/releases",
    "receipt_root": "/var/lib/pgw/promotion-receipts",
    "runtime_trust_manifest": "/etc/pgw/release-trust.manifest",
    "atomic_stage_required": true,
    "success_is_not_print_only": true
  },
  "runtime_lock": {
    "path": "/run/pgw-release-trust/promotion.lock",
    "parent": "/run/pgw-release-trust",
    "parent_owner": "root:root",
    "parent_allowed_modes": ["0700", "0750", "0755"],
    "provision_parent_each_boot": true,
    "file_owner": "root:root",
    "file_mode": "0600",
    "file_type": "regular",
    "file_size": 0,
    "file_link_count": 1,
    "system_run_lock_directory_forbidden": true
  },
  "required_native_entrypoint": {
    "path": "/opt/pgw-release-trust/bin/verify-release-attestation",
    "owner": "root:root",
    "mode": "0555",
    "hardlink_to": "/opt/pgw-release-trust/bin/attestor",
    "same_device_and_inode": true,
    "exact_link_count": 2,
    "symlink_or_copy_forbidden": true,
    "shell_interpreter_forbidden": true,
    "candidate_repository_entrypoint_file_forbidden": true,
    "single_reviewed_binary_asset": "attestor-linux-amd64",
    "fail_closed_atomic_update_order": ["attestor", "verify-release-attestation"],
    "execution_authority": "linux-kernel-at-execfn",
    "execfn_source": "/proc/self/auxv:AT_EXECFN",
    "execfn_must_equal_fixed_path": true,
    "execfn_exactly_one_and_auxv_terminated": true,
    "argv0_untrusted": true,
    "proc_self_exe_same_inode": true,
    "relative_symlink_proc_fd_and_execveat_paths_forbidden": true,
    "invocation": "verify-release-attestation <absolute-root-owned-readonly-tar> <absolute-root-owned-readonly-jsonl>",
    "bash_env_has_no_interpreter_surface": true,
    "post_verification_stdout": "byte-exact-canonical-pgw-promotion-result-v1-json",
    "post_verification_stderr": "empty",
    "authoritative_exit_codes": {
      "promoted": 0,
      "pre_commit_failed": 75,
      "commit_indeterminate": 76,
      "committed_durability_indeterminate": 77
    },
    "pre_verification_failure": "empty-stdout-sanitized-stderr-original-exit"
  },
  "prohibited": [
    "candidate-workflow-self-attestation",
    "candidate-job-oidc",
    "candidate-job-attestation-write",
    "candidate-code-execution-by-signer",
    "candidate-shipped-shell-trust-entrypoint",
    "bash-env-pre-interpreter-hook",
    "copied-or-symlinked-native-entrypoint",
    "candidate-provided-trust-policy",
    "online-attestation-api-during-promotion",
    "ambient-pat-on-pgw-host",
    "print-only-promotion-success"
  ]
}
