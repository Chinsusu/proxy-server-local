# PGW v2 non-secret environment template
PGW_API_ADDR=127.0.0.1:8080
PGW_AGENT_ADDR=127.0.0.1:9090
PGW_AGENT_SOCKET=/run/pgw/control/api-agent.sock
PGW_DB_PATH=/var/lib/pgw/pgw.db
PGW_LAN_IFACE=ens19
PGW_WAN_IFACE=eth0
# Required exact global IPv4 on PGW_LAN_IFACE; installer derives and persists it.
PGW_LAN_ADDRESS=192.168.2.1
PGW_MANAGEMENT_TCP_PORTS=8080,8081
PGW_FORWARDER_RUNTIME_ROOT=/run/pgw/forwarders
PGW_LKG_DIRECTORY=/var/lib/pgw/rules
PGW_FWD_BASE_PORT=15001
PGW_FWD_MAX_PORT=15999
# Installer writes the validated LAN IPv4; wildcard binds are forbidden.
PGW_UI_ADDR=192.168.2.1:8081
PGW_UI_API=http://127.0.0.1:8080
PGW_UI_WEB_DIR=/usr/local/share/pgw/web
PGW_HEALTH_INTERVAL=30s

# Secrets are intentionally absent. Production units load JWT/admin/AES/Agent,
# UI TLS/proxy identity and per-Forwarder proxy credentials via LoadCredential.
